@model List<ScoopAndServe2.Models.IceCream>
@{
    ViewData["Title"] = "Ice Cream List";
}
@if (Model == null || Model.Count == 0)
{
    <p>Sorry, there are no available icecreams right now.</p>
}
else
{
    <h1>Our shop have these icecreams </h1>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Price</th>
                <th>Category</th>
                <th>Available</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <th>@i.Id</th>
                    <th>@i.Name</th>
                    <th>@i.Price</th>       
                    <th>@i.Category</th>
                    <th>@i.IsAvailable</th>
                </tr>
            }
        </tbody>
    </table>
}